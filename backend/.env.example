# AYNAM backend (Render) — copy to .env.local for local development.
# Render: set these in the service environment instead.

# --- email (Resend for production; SMTP works but Render free tier often
#     blocks outbound 465/587 — use Resend's HTTP API there). ---
# SMTP option (dev / non-Render hosts):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-aynam-email@gmail.com
SMTP_PASSWORD=your-google-app-password
AYNAM_CONTACT_EMAIL=hello@aynam.in
# Resend option (recommended for Render):
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=AYNAM <hello@aynam.in>

# --- urls ---
# Public site origin (used inside emails + banner URLs)
AYNAM_SITE_URL=https://aynam.in
# Public asset CDN / image subdomain — email banner + og images absolute URL
AYNAM_ASSETS_URL=https://images.aynam.in
# Override banner URL if needed:
# AYNAM_EMAIL_BANNER_URL=https://images.aynam.in/images/email-banner.png
# Comma-separated origins allowed to call this API with credentials
CORS_ORIGINS=https://aynam.in,https://www.aynam.in,https://crm.aynam.in

# --- database + auth ---
# Production: MongoDB Atlas connection string.
# Development: leave blank (or set AYNAM_DEV_MONGO=1) to auto-use an embedded
# MongoDB in your OS temp dir — no Atlas whitelist needed.
MONGODB_URI=mongodb+srv://user:pass@cluster/aynam-crm
JWT_SECRET=openssl-rand-hex-32
ADMIN_EMAIL=owner@aynam.in
ADMIN_PASSWORD=
# Share the session cookie across subdomains in production (.aynam.in):
COOKIE_DOMAIN=.aynam.in

# --- rate limits ---
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_COOLDOWN_MS=20000
LOGIN_RATE_MAX=6
LOGIN_RATE_WINDOW_MS=600000

# --- DEVELOPMENT ONLY ---
# Force embedded MongoDB even if MONGODB_URI is set (useful when Atlas IP
# whitelist blocks your current network).
# AYNAM_DEV_MONGO=1
# AYNAM_SCHEDULER=off
