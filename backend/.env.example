# AYNAM backend (Render) — copy to .env.local for local development.
# Render: set these in the service environment instead.

# --- email (Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-aynam-email@gmail.com
SMTP_PASSWORD=your-google-app-password
AYNAM_CONTACT_EMAIL=where-enquiries-land@gmail.com

# --- urls ---
# Public site origin (used inside emails + banner URLs)
AYNAM_SITE_URL=https://aynam.in
# Comma-separated origins allowed to call this API with credentials
CORS_ORIGINS=https://aynam.in,https://crm.aynam.in

# --- database + auth ---
MONGODB_URI=mongodb+srv://user:pass@cluster/aynam-crm
JWT_SECRET=openssl-rand-hex-32
ADMIN_EMAIL=owner@aynam.in
ADMIN_PASSWORD=
# optional: share the session cookie across subdomains (.aynam.in)
# COOKIE_DOMAIN=.aynam.in

# --- rate limits ---
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_COOLDOWN_MS=20000
LOGIN_RATE_MAX=6
LOGIN_RATE_WINDOW_MS=600000

# --- DEVELOPMENT ONLY: embedded MongoDB in OS temp dir when MONGODB_URI unset ---
# AYNAM_DEV_MONGO=1
