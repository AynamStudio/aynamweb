{
  "name": "aynam-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AYNAM API backend — hardened Express server for the contact pipeline + internal CRM API.",
  "scripts": {
    "dev": "node --import tsx --env-file=.env.local src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create-admin": "node scripts/create-admin.mjs",
    "next:dev": "next dev -p 4000"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "next": "^15.5.4",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.13",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^5.7.2"
  }
}
