# AYNAM public website — copy to .env.local for local development.
# On Vercel set these in Project → Environment Variables.

# --- site ---
NEXT_PUBLIC_SITE_URL=https://aynam.in
# Public asset origin used for absolute URLs in email banners, og images etc.
# Create a DNS record: images.aynam.in → cname.vercel-dns.com (or point at Vercel)
# and Vercel will serve /public/** from that host as well as aynam.in.
NEXT_PUBLIC_ASSETS_URL=https://images.aynam.in

# --- backend (optional) ---
# If the backend CRM (Render) is running, the frontend /api/contact will proxy
# submissions here so leads + automations continue to flow. Leave blank to run
# the public site fully standalone (SMTP-only).
# Backend API base URL (server-only; the contact form posts through the
# Next.js /api/contact server route, which proxies to this address).
# Never prefix with NEXT_PUBLIC_ — it must NOT be inlined into the browser bundle.
API_URL=http://localhost:4000
# production: API_URL=https://api.aynam.in

# --- smtp (frontend-side email delivery) ---
# Vercel outbound SMTP works. Render's free tier blocks ports 465/587 which is
# why these live on the frontend. Use a Gmail App Password, or any SMTP server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-aynam-email@gmail.com
SMTP_PASSWORD=your-google-app-password
AYNAM_CONTACT_EMAIL=hello@aynam.in

# --- email assets ---
# Override the banner URL shown at the top of outgoing emails. Defaults to
# ${NEXT_PUBLIC_ASSETS_URL}/images/email-banner.png (file lives in
# /public/images/email-banner.png).
# AYNAM_EMAIL_BANNER_URL=https://images.aynam.in/images/email-banner.png

# --- crm (for "Open in CRM" button in admin notification emails) ---
AYNAM_CRM_URL=https://crm.aynam.in
